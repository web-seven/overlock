# Kubebuilder project file. The CLI lives in cmd/cli and the operator in
# cmd/operator; both share pkg/ and internal/.
domain: app
layout:
- go.kubebuilder.io/v4
projectName: overlock
repo: github.com/web-seven/overlock
resources:
- api:
    crdVersion: v1
  controller: true
  domain: app
  group: overlock
  kind: Environment
  path: github.com/web-seven/overlock/api/v1alpha1
  version: v1alpha1
version: "3"
