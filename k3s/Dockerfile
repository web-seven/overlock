# Overlock K3s image: K3s with the operator bootstrap manifests and the images
# of a default Overlock environment preloaded (airgap tarball).
#
# Build context: this directory with images.txt and operator.yaml generated by
# hack/k3s-image (see "make k3s-image-context").
ARG K3S_VERSION=v1.36.2-k3s1

# Pull the bundled images for the target architecture on the build platform.
FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS images
ARG TARGETARCH
ARG K3S_VERSION
ARG CRANE_VERSION=v0.20.2
RUN apk add --no-cache zstd \
    && go install github.com/google/go-containerregistry/cmd/crane@${CRANE_VERSION}
COPY images.txt /images.txt
RUN mkdir -p /out \
    && crane pull --platform "linux/${TARGETARCH}" $(cat /images.txt) /tmp/overlock-images.tar \
    && zstd -T0 -12 --rm /tmp/overlock-images.tar -o /out/overlock-images.tar.zst

# K3s system images (CoreDNS, metrics-server, local-path, Traefik, ...) from the
# K3s release, verified against its published checksums.
RUN set -e; \
    release="$(echo "${K3S_VERSION}" | sed 's/-k3s/%2Bk3s/')"; \
    base="https://github.com/k3s-io/k3s/releases/download/${release}"; \
    file="k3s-airgap-images-${TARGETARCH}.tar.zst"; \
    cd /tmp; \
    wget -q "${base}/${file}" "${base}/sha256sum-${TARGETARCH}.txt"; \
    grep " ${file}\$" "sha256sum-${TARGETARCH}.txt" | sha256sum -c -; \
    mv "${file}" /out/k3s-airgap-images.tar.zst

FROM rancher/k3s:${K3S_VERSION}
ARG K3S_VERSION
ARG OVERLOCK_VERSION=development
LABEL org.opencontainers.image.title="overlock-k3s" \
      org.opencontainers.image.description="K3s with Overlock operator manifests and preloaded environment images" \
      org.opencontainers.image.source="https://github.com/web-seven/overlock" \
      org.opencontainers.image.version="${OVERLOCK_VERSION}" \
      app.overlock.k3s-version="${K3S_VERSION}"

# Bundled artifacts live outside /var/lib/rancher/k3s, which is a volume and
# would hide them; the entrypoint links them into the data directory.
COPY --from=images /out/ /opt/overlock/images/
COPY images.txt /opt/overlock/images.txt
COPY operator.yaml /opt/overlock/manifests/operator.yaml
COPY entrypoint.sh /bin/overlock-entrypoint

ENTRYPOINT ["/bin/overlock-entrypoint"]
CMD ["agent"]
